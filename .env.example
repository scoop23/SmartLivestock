# Copy this file to .env for local Docker Compose overrides.
# Keep passwords URL-safe because DATABASE_URL is assembled from these values.
POSTGRES_DB=smartlivestock
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DJANGO_SECRET_KEY=replace-with-a-long-random-local-development-key
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
