# Copy this file to backend/.env for local development.
# Use a unique, long SECRET_KEY and never commit the filled .env file.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-local-development-key
DATABASE_URL=sqlite:///local.sqlite3

# Cloudflare R2 Object Storage (smartlivestock-prod)
# Leave unset or empty for local filesystem storage fallback
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=smartlivestock-prod
R2_ENDPOINT_URL=https://your-cloudflare-account-id.r2.cloudflarestorage.com

