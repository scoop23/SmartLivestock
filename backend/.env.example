# Copy this file to backend/.env for local development.
# Use a unique, long SECRET_KEY and never commit the filled .env file.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-local-development-key
DATABASE_URL=sqlite:///local.sqlite3
FRONTEND_URL=http://localhost:3000
# Didit returns the browser to FRONTEND_URL + /farmer-registration/identity.
# Local Django needs its own DIDIT_* and IDENTITY_* values in backend/.env.
# Local webhook destination: https://YOUR-TUNNEL/api/users/identity/webhook/

# Optional SMTP configuration for sending password reset emails.
# DEBUG=True uses Django's console email backend unless EMAIL_BACKEND is set.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=your-verified-sender@example.org

# Optional Ask SmartLivestock explanation service (Groq).
# Leave disabled until the current provider terms and data-sharing policy have
# been reviewed and approved. Core database answers work without these values.
SMARTLIVESTOCK_LLM_ENABLED=false
SMARTLIVESTOCK_LLM_DATA_SHARING_APPROVED=false
SMARTLIVESTOCK_LLM_PROVIDER=groq
SMARTLIVESTOCK_LLM_MODEL=openai/gpt-oss-20b
SMARTLIVESTOCK_LLM_TIMEOUT_SECONDS=8
GROQ_API_KEY=

# Cloudflare R2 Object Storage (smartlivestock-prod)
# Leave unset or empty for local filesystem storage fallback
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=smartlivestock-prod
R2_ENDPOINT_URL=

# Identity verification is OFF until the provider account and privacy policy are ready.
IDENTITY_ENABLED=false
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_APPLICATION_ID=
DIDIT_WEBHOOK_SECRET=
IDENTITY_ENVIRONMENT=sandbox
IDENTITY_POLICY_VERSION=
# Complete this notice after confirming the document policy with MAO/records/privacy
# personnel and the separate retention period configured in Didit. Do not enable
# verification with unresolved placeholders. The proposed metadata period is 15 days.
### Example (replace bracketed text before using):
# IDENTITY_RETENTION_NOTICE="SmartLivestock keeps automated identity-verification results for 15 days before scheduled cleanup, unless an authorized hold applies. Government ID uploads are kept according to [approved document retention policy]. Didit keeps captured ID and selfie data for [configured Didit retention period]. Authorized reviewers use this information to assess registration. For assistance, contact [privacy email]."
IDENTITY_RETENTION_NOTICE=
IDENTITY_PRIVACY_CONTACT=
# Proposed metadata period only, pending approval: IDENTITY_RETENTION_DAYS=15
# Keep 0 until agreed. Schedule expire_identity_sessions --execute separately;
# this setting does not delete uploaded IDs or configure Didit's retention.
IDENTITY_RETENTION_DAYS=0
# Confirm finite provider retention, template retention OFF, model training opted out,
# approved DPA/transfers, and document-method ID + PASSIVE liveness + face-match nodes.
IDENTITY_PROVIDER_PRIVACY_CONFIRMED=false
# Optional absolute path outside MEDIA_ROOT; persist this directory in deployment.
# PRIVATE_DOCUMENT_ROOT=/var/private/smartlivestock-documents
