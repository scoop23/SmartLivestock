Table roles {
  role_id integer [pk]
  role_name varchar [unique]
}

Table users {
  user_id integer [pk]

  role_id integer [not null]

  email varchar [unique, not null]
  password_hash varchar [not null]

  account_status varchar [note: 'Pending, Approved, Rejected, Suspended']

  created_at timestamp
  approved_at timestamp
}

Table permission {
  permission_id integer [pk]
  role_id integer
 }

Table barangays {
  barangay_id integer [pk]

  barangay_name varchar

  latitude decimal
  longitude decimal
}

Table farmers {
  farmer_id integer [pk]

  user_id integer [unique, not null]
  barangay_id integer [not null]

  address text
  contact_no varchar

  registered_at timestamp
}

Table cooperative_officers {
  officer_id integer [pk]

  user_id integer [unique, not null]
  barangay_id integer [not null]

  first_name varchar
  last_name varchar

  position varchar
}

Table livestock_types {
  livestock_type_id integer [pk]

  livestock_name varchar [unique]
}

Table livestock_inventory {
  livestock_id integer [pk]
  farmer_id integer [not null]
  livestock_type_id integer [not null]

  entry_type varchar [note: 'Individual, Batch']
  quantity integer [default: 1]
  tag_number varchar
  breed varchar
  sex varchar
  weight decimal
  health_status varchar
  last_vaccination_date date

  status varchar [note: 'Pending, Approved, Rejected']
  reviewed_by integer [note: 'FK to users.user_id - MAO']
  reviewed_at timestamp
  review_remarks text

  created_by integer [not null]
  created_at timestamp
}

Table production_records {
  production_id integer [pk]

  livestock_id integer [not null]

  production_type varchar
  quantity decimal

  record_date date

  status varchar [note: 'Pending, Verified, Approved, Rejected']

  reviewed_by integer
  reviewed_at timestamp
  review_remarks text

  created_by integer [not null]
  created_at timestamp
}

Table disease_cases {
  disease_case_id integer [pk]

  livestock_id integer [not null]

  disease_name varchar
  affected_count integer

  record_date date

  status varchar [note: 'Pending, Verified, Approved, Rejected']

  reviewed_by integer
  reviewed_at timestamp
  review_remarks text

  created_by integer [not null]
  created_at timestamp
}
Table mortality_records {
  mortality_id integer [pk]
  livestock_id integer [not null]

  death_count integer
  cause varchar
  source_disease_case_id integer [note: 'Nullable - set if death was caused by a tracked disease case']

  record_date date
  status varchar
  reviewed_by integer
  reviewed_at timestamp
  review_remarks text
  created_by integer [not null]
  created_at timestamp
}

Table slaughter_records {
  slaughter_id integer [pk]

  livestock_id integer [not null]

  quantity integer

  record_date date

  status varchar [note: 'Pending, Verified, Approved, Rejected']

  reviewed_by integer
  reviewed_at timestamp
  review_remarks text

  created_by integer [not null]
  created_at timestamp
}

Table live_animal_sales {
  sale_id integer [pk]
  livestock_id integer [not null]

  quantity integer
  price_per_head decimal [note: 'Nullable - farmer may not always disclose']
  total_price decimal [note: 'Nullable - total sale amount']
  destination varchar

  sale_date date
  status varchar
  reviewed_by integer
  reviewed_at timestamp
  review_remarks text
  created_by integer [not null]
  created_at timestamp
}

Table barangay_livestock_census {
  census_id integer [pk]

  barangay_id integer
  livestock_type_id integer

  total_population integer

  census_date date

  submitted_by integer
  status varchar [note: 'Pending, Verified, Approved, Rejected']
  reviewed_by integer
  reviewed_at timestamp

